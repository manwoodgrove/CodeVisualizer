# Dev-mode defaults (pnpm dev).
# For Docker mode, docker-compose.yml overrides CORS_ORIGIN and
# GITHUB_CALLBACK_URL to reference the frontend port (38847).
# Register this callback on your GitHub OAuth App for Docker mode:
#   http://localhost:38847/auth/github/callback
#
# Copy this file to apps/api/.env and fill in real values.
# .env is gitignored; .env.example is committed. Never put real
# secrets in this file.
PORT=4000
HOST=0.0.0.0
SESSION_SECRET=change-me-in-prod-use-64-random-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
REDIS_URL=redis://localhost:6379
DATABASE_URL=file:./data/app.sqlite
CORS_ORIGIN=http://localhost:5173
