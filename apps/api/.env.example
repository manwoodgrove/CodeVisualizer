PORT=4000
HOST=0.0.0.0
SESSION_SECRET=change-me-in-prod-use-64-random-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Docker note: GITHUB_CALLBACK_URL must be reachable from the user's browser.
# When running via docker compose, port 4000 is exposed on the host, so keep
# this as localhost:4000 — do NOT change it to the internal service name (api).
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
REDIS_URL=redis://localhost:6379
DATABASE_URL=file:./data/app.sqlite
CORS_ORIGIN=http://localhost:5173
